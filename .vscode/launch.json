{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Listen for Xdebug",
        "type": "php",
        "request": "launch",
        "port": 9003,
        "pathMappings": {
          "/var/www/pirago-workshop": "${workspaceFolder}"
        },
        "log": false,
        "xdebugSettings": {
          "max_children": 128,
          "max_depth": 3,
          "show_hidden": 1
        }
      }
    ]
  }